# Required for live LLM/data-provider calls.
MX_APIKEY=
MX_API_URL=https://mkapi2.dfcfs.com/finskillshub
MINIMAX_API_KEY=
MX_DIRECT_KEY=
VOLCAN_API_KEY=
VOLCAN_ENGINE_API_KEY=
OPENAI_API_KEY=

# Model routing. Replace these names with providers configured in your environment.
STOCK_SELECTION_DEFAULT_MODEL=volcengine-plan/ark-code-latest
STOCK_SELECTION_FALLBACK_MODEL=openai/gpt-5.6-sol
STOCK_SELECTION_SECONDARY_FALLBACK_MODEL=minimax-portal/MiniMax-M3

# Optional notification target.
FEISHU_WEBHOOK_URL=

# Local market-data bridge. Defaults are local-only placeholders.
QMT_HTTP_URL=http://127.0.0.1:8080
XQSHARE_HTTP_BASE=http://127.0.0.1:8080
XQSHARE_HOST=127.0.0.1
XQSHARE_PORT=18812
XQSHARE_REMOTE_HOST=127.0.0.1
XQSHARE_CLIENT_ID=
XQSHARE_CLIENT_SECRET=

# Safer default for public checkouts.
DRY_RUN=1
PORTFOLIO_VALUE=1000000
OPENCLAW_WORKSPACE=.
OPENCLAW_HOME=
